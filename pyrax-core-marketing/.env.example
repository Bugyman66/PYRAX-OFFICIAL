# Database
DATABASE_URL="postgresql://user:password@localhost:5432/pyrax_proofing_hub?schema=public"

# Authentication
NEXTAUTH_SECRET="your-secret-key-min-32-chars-here"
NEXTAUTH_URL="https://marketing.pyrax.org"

# Google Drive Integration (OAuth 2.0)
# Create OAuth credentials in Google Cloud Console:
# 1. Go to APIs & Services → Credentials
# 2. Create OAuth client ID (Web application)
# 3. Add authorized redirect URI: https://marketing.pyrax.org/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://marketing.pyrax.org/api/auth/google/callback"

# Brevo (Transactional Email)
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="noreply@pyrax.org"
BREVO_SENDER_NAME="PYRAX Proofing Hub"

# Application
NEXT_PUBLIC_APP_URL="https://marketing.pyrax.org"
NEXT_PUBLIC_APP_NAME="PYRAX Proofing Hub"
INTERNAL_EMAIL_DOMAIN="pyrax.org"

# Magic Link
MAGIC_LINK_EXPIRY_MINUTES=15
SESSION_EXPIRY_DAYS=30
