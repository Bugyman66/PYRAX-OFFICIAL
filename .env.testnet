# PYRAX Testnet Environment Configuration
# Copy this file to .env on your testnet server

# ===========================================
# Network Configuration
# ===========================================
NETWORK=testnet
PYRAX_NETWORK=testnet

# ===========================================
# Public URLs (for frontend builds)
# ===========================================
NEXT_PUBLIC_NETWORK=testnet
NEXT_PUBLIC_RPC_URL=https://rpc.testnet.pyrax.org
NEXT_PUBLIC_API_URL=https://api.testnet.pyrax.org
NEXT_PUBLIC_EXPLORER_URL=https://explorer.testnet.pyrax.org

# ===========================================
# Internal RPC (for server-side services)
# ===========================================
RPC_URL=http://localhost:8545
TESTNET_RPC_URL=http://localhost:8545

# ===========================================
# Faucet Configuration
# ===========================================
# Private key for faucet wallet (KEEP SECRET!)
FAUCET_PRIVATE_KEY=your_testnet_faucet_private_key_here

# Amount of PYRAX to dispense per request
FAUCET_AMOUNT=100

# Rate limit in hours between requests per address
RATE_LIMIT_HOURS=1

# ===========================================
# Docusaurus (Docs site)
# ===========================================
DOCUSAURUS_URL=https://docs.testnet.pyrax.org
