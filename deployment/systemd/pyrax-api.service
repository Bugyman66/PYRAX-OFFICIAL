[Unit]
Description=PYRAX API Gateway
After=network.target pyrax-node.service
Wants=pyrax-node.service

[Service]
Type=simple
User=pyrax
Group=pyrax
EnvironmentFile=/opt/pyrax/deployment/env/%i.env
WorkingDirectory=/opt/pyrax
ExecStart=/opt/pyrax/pyrax-node/target/release/pyrax-api \
    --bind ${API_BIND} \
    --port ${API_PORT} \
    --rpc-url http://127.0.0.1:${PYRAX_RPC_PORT}
Restart=always
RestartSec=5

# Security hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
