# PYRAX Devnet Environment Configuration
# Active development environment

# ===========================================
# NETWORK CONFIGURATION
# ===========================================
PYRAX_ENV=devnet
PYRAX_NETWORK=devnet
PYRAX_CHAIN_ID=28545

# ===========================================
# DOMAIN CONFIGURATION
# ===========================================
PYRAX_DOMAIN=dev.pyrax.org
PYRAX_EXPLORER_URL=https://explorer.dev.pyrax.org
PYRAX_RPC_URL=https://rpc.dev.pyrax.org
PYRAX_API_URL=https://api.dev.pyrax.org
PYRAX_FAUCET_URL=https://faucet.dev.pyrax.org
PYRAX_WS_URL=wss://rpc.dev.pyrax.org/ws

# ===========================================
# NODE CONFIGURATION
# ===========================================
PYRAX_NODE_PORT=30303
PYRAX_RPC_PORT=8545
PYRAX_RPC_BIND=127.0.0.1
PYRAX_LOG_LEVEL=debug
PYRAX_DATA_DIR=/var/lib/pyrax/devnet

# Mining (enabled for devnet)
PYRAX_MINING_ENABLED=true
PYRAX_MINING_THREADS=2

# ===========================================
# EXPLORER CONFIGURATION
# ===========================================
NEXT_PUBLIC_NETWORK=devnet
NEXT_PUBLIC_RPC_URL=https://rpc.dev.pyrax.org
NEXT_PUBLIC_API_URL=https://api.dev.pyrax.org
NEXT_PUBLIC_CHAIN_ID=28545
NEXT_PUBLIC_EXPLORER_URL=https://explorer.dev.pyrax.org

# ===========================================
# API CONFIGURATION
# ===========================================
API_PORT=8080
API_BIND=127.0.0.1
API_RATE_LIMIT=1000
API_CORS_ORIGINS=https://explorer.dev.pyrax.org,https://dev.pyrax.org

# ===========================================
# FAUCET CONFIGURATION
# ===========================================
FAUCET_ENABLED=true
FAUCET_AMOUNT=1000
FAUCET_COOLDOWN=3600
FAUCET_DAILY_LIMIT=10000

# ===========================================
# DATABASE
# ===========================================
DATABASE_URL=postgresql://pyrax:pyrax_dev@localhost:5432/pyrax_devnet

# ===========================================
# MONITORING
# ===========================================
METRICS_ENABLED=true
METRICS_PORT=9090
