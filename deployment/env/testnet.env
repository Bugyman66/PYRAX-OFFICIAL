# PYRAX Testnet Environment Configuration
# End user beta testing environment

# ===========================================
# NETWORK CONFIGURATION
# ===========================================
PYRAX_ENV=testnet
PYRAX_NETWORK=testnet
PYRAX_CHAIN_ID=18545

# ===========================================
# DOMAIN CONFIGURATION
# ===========================================
PYRAX_DOMAIN=testnet.pyrax.org
PYRAX_EXPLORER_URL=https://explorer.testnet.pyrax.org
PYRAX_RPC_URL=https://rpc.testnet.pyrax.org
PYRAX_API_URL=https://api.testnet.pyrax.org
PYRAX_FAUCET_URL=https://faucet.testnet.pyrax.org
PYRAX_WS_URL=wss://rpc.testnet.pyrax.org/ws

# ===========================================
# NODE CONFIGURATION
# ===========================================
PYRAX_NODE_PORT=30303
PYRAX_RPC_PORT=8545
PYRAX_RPC_BIND=127.0.0.1
PYRAX_LOG_LEVEL=info
PYRAX_DATA_DIR=/var/lib/pyrax/testnet

# Mining (enabled for testnet)
PYRAX_MINING_ENABLED=true
PYRAX_MINING_THREADS=4

# ===========================================
# EXPLORER CONFIGURATION
# ===========================================
NEXT_PUBLIC_NETWORK=testnet
NEXT_PUBLIC_RPC_URL=https://rpc.testnet.pyrax.org
NEXT_PUBLIC_API_URL=https://api.testnet.pyrax.org
NEXT_PUBLIC_CHAIN_ID=18545
NEXT_PUBLIC_EXPLORER_URL=https://explorer.testnet.pyrax.org

# ===========================================
# API CONFIGURATION
# ===========================================
API_PORT=8080
API_BIND=127.0.0.1
API_RATE_LIMIT=500
API_CORS_ORIGINS=https://explorer.testnet.pyrax.org,https://testnet.pyrax.org

# ===========================================
# FAUCET CONFIGURATION
# ===========================================
FAUCET_ENABLED=true
FAUCET_AMOUNT=100
FAUCET_COOLDOWN=7200
FAUCET_DAILY_LIMIT=1000

# ===========================================
# DATABASE
# ===========================================
DATABASE_URL=postgresql://pyrax:pyrax_testnet@localhost:5432/pyrax_testnet

# ===========================================
# MONITORING
# ===========================================
METRICS_ENABLED=true
METRICS_PORT=9090
