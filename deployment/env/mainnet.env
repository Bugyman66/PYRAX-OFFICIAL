# PYRAX Mainnet Environment Configuration
# Production environment

# ===========================================
# NETWORK CONFIGURATION
# ===========================================
PYRAX_ENV=mainnet
PYRAX_NETWORK=mainnet
PYRAX_CHAIN_ID=8545

# ===========================================
# DOMAIN CONFIGURATION
# ===========================================
PYRAX_DOMAIN=pyrax.org
PYRAX_EXPLORER_URL=https://explorer.pyrax.org
PYRAX_RPC_URL=https://rpc.pyrax.org
PYRAX_API_URL=https://api.pyrax.org
PYRAX_WS_URL=wss://rpc.pyrax.org/ws

# ===========================================
# NODE CONFIGURATION
# ===========================================
PYRAX_NODE_PORT=30303
PYRAX_RPC_PORT=8545
PYRAX_RPC_BIND=127.0.0.1
PYRAX_LOG_LEVEL=warn
PYRAX_DATA_DIR=/var/lib/pyrax/mainnet

# Mining (public mining)
PYRAX_MINING_ENABLED=false

# ===========================================
# EXPLORER CONFIGURATION
# ===========================================
NEXT_PUBLIC_NETWORK=mainnet
NEXT_PUBLIC_RPC_URL=https://rpc.pyrax.org
NEXT_PUBLIC_API_URL=https://api.pyrax.org
NEXT_PUBLIC_CHAIN_ID=8545
NEXT_PUBLIC_EXPLORER_URL=https://explorer.pyrax.org

# ===========================================
# API CONFIGURATION
# ===========================================
API_PORT=8080
API_BIND=127.0.0.1
API_RATE_LIMIT=100
API_CORS_ORIGINS=https://explorer.pyrax.org,https://pyrax.org,https://www.pyrax.org

# ===========================================
# FAUCET CONFIGURATION
# ===========================================
FAUCET_ENABLED=false

# ===========================================
# DATABASE
# ===========================================
DATABASE_URL=postgresql://pyrax:CHANGE_THIS_PASSWORD@localhost:5432/pyrax_mainnet

# ===========================================
# MONITORING
# ===========================================
METRICS_ENABLED=true
METRICS_PORT=9090
